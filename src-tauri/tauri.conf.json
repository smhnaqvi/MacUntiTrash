{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Disk Detective",
  "version": "0.1.6",
  "identifier": "local.diskdetective",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Disk Detective",
        "width": 960,
        "height": 680,
        "minWidth": 680,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": [
      "bin/mac-disk-scan.sh"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
