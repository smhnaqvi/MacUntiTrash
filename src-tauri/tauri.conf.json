{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpaceGlance",
  "version": "0.1.6",
  "identifier": "com.deviatech.spaceglance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpaceGlance",
        "width": 960,
        "height": 680,
        "minWidth": 680,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "category": "Utility"
  }
}
